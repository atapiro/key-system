class CS2Memory:
    def __init__(self):
        self.pm = None
        self.client = None
        self.attach()

    def attach(self):
        try:
            self.pm = pymem.Pymem("cs2.exe")
            self.client = pymem.process.module_from_name(self.pm.process_handle, "client.dll").lpBaseOfDll
            print(f"[+] CS2 attached. client.dll: 0x{self.client:X}")
        except pymem.exception.ProcessNotFound:
            print("[!] CS2 not running.")
            sys.exit(1)

    def read_int(self, addr): return self.pm.read_int(addr)
    def read_uint(self, addr): return self.pm.read_uint(addr)
    def read_float(self, addr): return self.pm.read_float(addr)
    def read_bool(self, addr): return self.pm.read_bool(addr)
    def read_vec3(self, addr): return [self.read_float(addr), self.read_float(addr+4), self.read_float(addr+8)]
    def read_string(self, addr, max_len=64):
        try:
            raw = self.pm.read_bytes(addr, max_len)
            end = raw.find(b'\x00')
            return raw[:end].decode('utf-8', errors='ignore')
        except: return ""
    def write_int(self, addr, val): self.pm.write_int(addr, val)
    def write_float(self, addr, val): self.pm.write_float(addr, val)
    def write_bool(self, addr, val): self.pm.write_bool(addr, val)

    def get_local_pawn(self):
        return self.read_int(self.client + OffsetManager.get("dwLocalPlayerPawn"))
    def get_entity_list(self):
        return self.client + OffsetManager.get("dwEntityList")
    def get_view_matrix(self):
        addr = self.client + OffsetManager.get("dwViewMatrix")
        return [self.read_float(addr + i*4) for i in range(16)]
    def get_glow_manager(self):
        return self.client + OffsetManager.get("dwGlowManager")
    def get_force_attack(self):
        return self.client + OffsetManager.get("dwForceAttack")
    def get_force_jump(self):
        return self.client + OffsetManager.get("dwForceJump")

