        data = None
        try:
            # Önce yerel dosyayı dene
            if os.path.exists(cls.LOCAL_PATH):
                with open(cls.LOCAL_PATH, 'r') as f:
                    data = json.load(f)
                print("[+] Offsets loaded from local file.")
            else:
