user32 = ctypes.windll.user32

class Overlay:
    def __init__(self, width, height):
        os.environ['SDL_VIDEO_WINDOW_POS'] = "0,0"
        pygame.init()
        self.width = width; self.height = height
        self.screen = pygame.display.set_mode((width, height), pygame.NOFRAME | pygame.SRCALPHA)
        pygame.display.set_caption("CS2 ESP")
        self.hwnd = pygame.display.get_wm_info()['window']
        self._set_transparent()
        self.clock = pygame.time.Clock()
        self.font = pygame.font.SysFont("Consolas", 14)
        self.big_font = pygame.font.SysFont("Consolas", 20)
        self.small_font = pygame.font.SysFont("Consolas", 11)
        self.running = True
        self.hit_marker_timer = 0
        self.hit_pos = (0, 0)

    def _set_transparent(self):
        styles = user32.GetWindowLongW(self.hwnd, -20)
        styles |= 0x80000 | 0x20
        user32.SetWindowLongW(self.hwnd, -20, styles)
        user32.SetLayeredWindowAttributes(self.hwnd, 0, 0, 0x1)
        user32.SetWindowPos(self.hwnd, -1, 0, 0, self.width, self.height, 0x2 | 0x4 | 0x40)

    def clear(self): self.screen.fill((0,0,0,0))
    def draw_box(self, x, y, w, h, color, thick=2):
        pygame.draw.rect(self.screen, color, (x, y, w, h), thick)
    def draw_line(self, x1,y1,x2,y2,color,thick=2):
        pygame.draw.line(self.screen, color, (x1,y1), (x2,y2), thick)
    def draw_circle(self, x, y, radius, color, thick=2):
        pygame.draw.circle(self.screen, color, (x, y), radius, thick)
    def draw_text(self, text, x, y, color, font=None):
        if font is None: font = self.font
        surf = font.render(text, True, color)
        self.screen.blit(surf, (x, y))
    def draw_skeleton(self, bones, color):
        conn = [(0,4),(4,5),(5,6),(0,1),(1,2),(2,3),(0,7),(7,8),(8,9),(5,10),(10,11),(11,12),(5,13),(13,14),(14,15)]
        for a,b in conn:
            if a in bones and b in bones:
                self.draw_line(bones[a][0], bones[a][1], bones[b][0], bones[b][1], color, 2)
    def draw_hit_marker(self):
        if time.time() - self.hit_marker_timer < 0.3:
            x,y = self.hit_pos; c=(255,0,0); s=30
            self.draw_line(x-s, y-s, x-s//2, y-s//2, c, 4)
            self.draw_line(x+s, y-s, x+s//2, y-s//2, c, 4)
            self.draw_line(x-s, y+s, x-s//2, y+s//2, c, 4)
            self.draw_line(x+s, y+s, x+s//2, y+s//2, c, 4)
    def draw_bomb_timer(self, timer, defuse_timer, x, y):
        if timer > 0:
            color = (255,50,0) if timer < 10 else (255,200,0)
            txt = f"BOMB: {timer:.1f}s"
            if defuse_timer > 0:
                txt += f" | DEFUSE: {defuse_timer:.1f}s"
            self.draw_text(txt, x, y, color, self.big_font)
    def render(self): pygame.display.flip()
    def handle_events(self):
        for e in pygame.event.get():
            if e.type == pygame.QUIT: self.running = False
            elif e.type == pygame.KEYDOWN and e.key == pygame.K_END: self.running = False
    def close(self): pygame.quit()

