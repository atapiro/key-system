def get_bone_pos(mem, pawn_addr, bone_id):
    model_state = mem.read_int(pawn_addr + OffsetManager.get("m_modelState"))
    if not model_state: return None
    bone_matrix = mem.read_int(model_state + 0x80)
    if not bone_matrix: return None
    return [mem.read_float(bone_matrix + bone_id*32 + 0),
            mem.read_float(bone_matrix + bone_id*32 + 4),
            mem.read_float(bone_matrix + bone_id*32 + 8)]

def get_entity_from_list(mem, list_addr, index):
    """CS2 entity list reader - more reliable than old CSGO method."""
    entity_system = mem.read_int(list_addr)
    if not entity_system:
        return 0
    entity_list = mem.read_int(entity_system + 0x10)  # C_EntitySystem::m_entityList
    if not entity_list:
        return 0
    idx = index & 0x7FFF
    return mem.read_int(entity_list + (idx * 0x78))

def get_weapon_name_by_idx(idx):
    return WEAPON_DATA.get(idx, f"ID:{idx}")

def get_weapon_damage_by_idx(idx):
    return WEAPON_DAMAGE.get(idx, None)

def is_entity_visible(mem, local_pawn, target_pawn, target_index):
    crosshair_id = mem.read_int(local_pawn + OffsetManager.get("m_iIDEntIndex"))
    spotted = mem.read_int(target_pawn + OffsetManager.get("m_bSpottedByMask"))
    return (crosshair_id == target_index) or (spotted & 1) == 1

def find_bomb_carrier(mem, list_addr):
    for i in range(1, 512):
        ent = get_entity_from_list(mem, list_addr, i)
        if not ent: continue
        idx = mem.read_int(ent + OffsetManager.get("m_iItemDefinitionIndex"))
        if idx == 49:
            owner = mem.read_int(ent + OffsetManager.get("m_hOwnerEntity")) & 0x7FFF
            if owner:
                return get_entity_from_list(mem, list_addr, owner)
    return 0

