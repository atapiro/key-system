def world_to_screen(pos, matrix, width, height):
    w = matrix[12]*pos[0] + matrix[13]*pos[1] + matrix[14]*pos[2] + matrix[15]
    if w < 0.01: return None
    x = (matrix[0]*pos[0] + matrix[1]*pos[1] + matrix[2]*pos[2] + matrix[3]) / w
    y = (matrix[4]*pos[0] + matrix[5]*pos[1] + matrix[6]*pos[2] + matrix[7]) / w
    return (int((width/2)*(1+x)), int((height/2)*(1-y)))

def normalize_angle(ang):
    while ang[0] > 89.0: ang[0] -= 180.0
    while ang[0] < -89.0: ang[0] += 180.0
    while ang[1] > 180.0: ang[1] -= 360.0
    while ang[1] < -180.0: ang[1] += 360.0
    return ang

def calc_angle(local_pos, target_pos, view_angles):
    delta = [target_pos[0]-local_pos[0], target_pos[1]-local_pos[1], target_pos[2]-local_pos[2]]
    hyp = math.sqrt(delta[0]**2 + delta[1]**2 + delta[2]**2)
    if hyp < 1.0: return view_angles
    pitch = -math.degrees(math.asin(delta[2]/hyp))
    yaw = math.degrees(math.atan2(delta[1], delta[0]))
    return normalize_angle([pitch, yaw])

def get_fov(view_angle, target_angle):
    return math.sqrt((target_angle[1]-view_angle[1])**2 + (target_angle[0]-view_angle[0])**2)

