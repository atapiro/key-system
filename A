    def reset_defaults(self):
        default = {
            'aimbot': True, 'trigger': True, 'bhop': True, 'chams': True,
            'chams_mode': 'wall', 'autowall': False,
            'esp_box': True, 'esp_skeleton': True, 'esp_health': True, 'esp_weapon': True,
            'esp_distance': True,
            'item_esp': True, 'smoke_esp': True, 'molotov_esp': True, 'grenade_traj': True,
            'radar': True, 'noflash': True, 'hitmarker': True, 'autopistol': False,
            'spectators': True, 'bomb_carrier': True,
            'enemy_color': [255,0,0], 'team_color': [0,255,0],
            'aim_fov': 12, 'aim_smooth': 5.0, 'trigger_delay': 0.04, 'min_damage': 30
        }
        with settings_lock:
            settings.clear()
            settings.update(default)
        self.update_gui_from_settings()
        self.apply_settings()
        self.status_label.config(text="Defaults Restored!", foreground="blue")
        self.root.after(2000, lambda: self.status_label.config(text="Ready"))

    def on_close(self):
        self.running = False
        self.root.destroy()
        os._exit(0)

    def run(self):
        self.root.mainloop()

# ------------------------------------------------------------------
# 9. MAIN
# ------------------------------------------------------------------
def main():
    OffsetManager.fetch()
    game_thread = threading.Thread(target=game_loop, daemon=True)
    game_thread.start()
    gui = CheatGUI()
    gui.run()

if __name__ == "__main__":
    main()
