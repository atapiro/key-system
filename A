def simulate_grenade_trajectory(mem, grenade_ent, steps=30):
    origin = mem.read_vec3(grenade_ent + OffsetManager.get("m_vecOrigin"))
    velocity = mem.read_vec3(grenade_ent + OffsetManager.get("m_vecVelocity"))
    if not origin or not velocity: return []
    g = -800.0
    positions = []
    dt = 0.03
    pos = origin[:]
    vel = velocity[:]
    for _ in range(steps):
        pos[0] += vel[0] * dt
        pos[1] += vel[1] * dt
        pos[2] += vel[2] * dt
        vel[2] += g * dt
        positions.append(pos[:])
        if pos[2] < -100:
            break
    return positions

def game_loop():
    mem = CS2Memory()
    screen_w = user32.GetSystemMetrics(0)
    screen_h = user32.GetSystemMetrics(1)
    overlay = Overlay(screen_w, screen_h)

    def get_setting(key, default=None):
        with settings_lock: return settings.get(key, default)

    print("[*] Game loop started. END to quit.")
    enemy_health_cache = {}

    while overlay.running:
        try:
            overlay.handle_events()
            overlay.clear()

            local_pawn = mem.get_local_pawn()
            if not local_pawn:
                overlay.render()
                overlay.clock.tick(30)
                continue

            view_matrix = mem.get_view_matrix()
            list_addr = mem.get_entity_list()
            local_team = mem.read_int(local_pawn + OffsetManager.get("m_iTeamNum"))
            local_pos = mem.read_vec3(local_pawn + OffsetManager.get("m_vecOrigin"))

