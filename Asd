def check_pc_channel(ctx):
    if ctx.author.id != ALLOWED_USER_ID:
        return False
    username_clean = re.sub(r'[^a-z0-9\-_]', '-', DISCORD_USERNAME.lower())
    pc_name_clean = re.sub(r'[^a-z0-9\-_]', '-', PC_NAME.lower())
    ip_clean = PC_IP.replace('.', '-')
    channel_name = f"pc-{pc_name_clean}-{ip_clean}-{username_clean}"
    if len(channel_name) > 80:
        channel_name = channel_name[:80]
    return ctx.channel.name == channel_name

async def parse_sure(args: str) -> int:
    if not args.strip():
        return 0
    match = re.match(r'^(\d+)$', args.strip())
    return int(match.group(1)) if match else 0

