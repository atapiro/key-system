                file = discord.File(buf, "ekran.png")
                embed = discord.Embed(title="Ekran Görüntüsü", color=0x00ff00)
                embed.set_image(url="attachment://ekran.png")
                await ctx.send(embed=embed, file=file)
                return
            screenshots = []
            total_width = 0
            max_height = 0
            for i in range(1, len(monitors)):
                monitor = monitors[i]
                sct_img = sct.grab(monitor)
                img = Image.frombytes("RGB", sct_img.size, sct_img.rgb)
                screenshots.append(img)
                total_width += img.width
                if img.height > max_height:
                    max_height = img.height
            combined = Image.new('RGB', (total_width, max_height))
            x_offset = 0
            for img in screenshots:
                combined.paste(img, (x_offset, 0))
                x_offset += img.width
            combined.thumbnail((1280, 720))
            buf = io.BytesIO()
            combined.save(buf, format="PNG")
            buf.seek(0)
            file = discord.File(buf, "ekran.png")
            embed = discord.Embed(title=f"Ekran Görüntüsü ({len(screenshots)} Monitör)", color=0x00ff00)
            embed.set_image(url="attachment://ekran.png")
            await ctx.send(embed=embed, file=file)
