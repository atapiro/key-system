@bot.command(name="volume")
async def volume(ctx, *, arg: str = ""):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    if not PYCAW_AVAILABLE:
        await ctx.send("❌ `pycaw` yüklü değil. `pip install pycaw comtypes`")
        return
    try:
        devices = AudioUtilities.GetSpeakers()
        volume = devices.EndpointVolume.QueryInterface(IAudioEndpointVolume)
        if not arg.strip():
            current = volume.GetMasterVolumeLevelScalar() * 100
            mute = volume.GetMute()
            durum = "🔇 Sessiz" if mute else f"🔊 Ses: %{current:.0f}"
            await ctx.send(durum)
            return
        if arg.lower() == "mute":
            volume.SetMute(True, None)
            await ctx.send("🔇 Sessize alındı.")
            return
        if arg.lower() == "unmute":
            volume.SetMute(False, None)
            await ctx.send("🔊 Sessiz kaldırıldı.")
            return
        if arg.lower() == "up":
            current = volume.GetMasterVolumeLevelScalar() * 100
            new_vol = min(100, current + 5)
            volume.SetMasterVolumeLevelScalar(new_vol / 100, None)
            await ctx.send(f"🔊 Ses %{new_vol:.0f} yapıldı.")
            return
        if arg.lower() == "down":
            current = volume.GetMasterVolumeLevelScalar() * 100
            new_vol = max(0, current - 5)
            volume.SetMasterVolumeLevelScalar(new_vol / 100, None)
            await ctx.send(f"🔊 Ses %{new_vol:.0f} yapıldı.")
            return
        try:
            val = int(arg)
            if val < 0 or val > 100:
                await ctx.send("❌ 0-100 arasında değer girin.")
                return
            volume.SetMasterVolumeLevelScalar(val / 100, None)
            await ctx.send(f"🔊 Ses %{val} yapıldı.")
        except ValueError:
            await ctx.send("❌ Geçersiz. Kullanım: `!volume`, `!volume up/down`, `!volume mute/unmute`, `!volume 0-100`")
    except Exception as e:
        await ctx.send(f"❌ Ses ayarı hatası: {e}")

