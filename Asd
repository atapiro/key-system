async def create_pc_channel(guild):
    try:
        username_clean = re.sub(r'[^a-z0-9\-_]', '-', DISCORD_USERNAME.lower())
        pc_name_clean = re.sub(r'[^a-z0-9\-_]', '-', PC_NAME.lower())
        ip_clean = PC_IP.replace('.', '-')
        channel_name = f"pc-{pc_name_clean}-{ip_clean}-{username_clean}"
        if len(channel_name) > 80:
            channel_name = channel_name[:80]
        existing_channel = discord.utils.get(guild.channels, name=channel_name)
        if existing_channel:
            return existing_channel
        overwrites = {
            guild.default_role: discord.PermissionOverwrite(read_messages=False),
            guild.me: discord.PermissionOverwrite(read_messages=True, send_messages=True),
        }
        allowed_user = guild.get_member(ALLOWED_USER_ID)
        if allowed_user:
            overwrites[allowed_user] = discord.PermissionOverwrite(read_messages=True, send_messages=True)
        channel = await guild.create_text_channel(
            channel_name,
            overwrites=overwrites,
            reason=f"PC Bağlantı Kanalı: {PC_NAME} ({PC_IP}) - {DISCORD_USERNAME}"
        )
        await channel.send(f"🖥️ **PC Bağlandı!**\n"
                          f"**Bilgisayar:** `{PC_NAME}`\n"
                          f"**IP Adresi:** `{PC_IP}`\n"
                          f"**Discord Kullanıcısı:** `{DISCORD_USERNAME}`\n"
                          f"**Bağlantı Zamanı:** <t:{int(time.time())}:F>\n"
                          f"---\n"
                          f"Bu kanal **sadece bu PC** için özeldir. Komutlar bu PC'ye etki eder.\n"
                          f"**Toplu komutlar için `!toplu` kullanın.**")
        pc_id = f"{PC_NAME}-{PC_IP}"
        pc_list[pc_id] = {
            "name": PC_NAME,
            "ip": PC_IP,
            "user": DISCORD_USERNAME,
            "channel": channel.id,
            "last_seen": time.time()
        }
        user_channels[ALLOWED_USER_ID] = channel.id
        return channel
    except Exception as e:
        print(f"Kanal oluşturma hatası: {e}")
        return None

async def send_status_update(guild, status: str, message: str = ""):
    try:
        username_clean = re.sub(r'[^a-z0-9\-_]', '-', DISCORD_USERNAME.lower())
        pc_name_clean = re.sub(r'[^a-z0-9\-_]', '-', PC_NAME.lower())
        ip_clean = PC_IP.replace('.', '-')
        channel_name = f"pc-{pc_name_clean}-{ip_clean}-{username_clean}"
        if len(channel_name) > 80:
            channel_name = channel_name[:80]
        channel = discord.utils.get(guild.channels, name=channel_name)
        if channel:
            if status == "online":
                await channel.send(f"✅ **PC Online** {message}\nIP: {PC_IP}\nKullanıcı: {DISCORD_USERNAME}")
            elif status == "offline":
                await channel.send(f"❌ **PC Offline** {message}\nIP: {PC_IP}\nKullanıcı: {DISCORD_USERNAME}")
            elif status == "info":
                await channel.send(message)
    except Exception as e:
        print(f"Durum güncelleme hatası: {e}")

