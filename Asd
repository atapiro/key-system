@bot.command(name="ls")
async def ls(ctx, *, arg: str = ""):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    try:
        user_home = os.path.expanduser("~")
        shortcuts = {
            "desktop": os.path.join(user_home, "Desktop"),
            "masaüstü": os.path.join(user_home, "Desktop"),
            "downloads": os.path.join(user_home, "Downloads"),
            "indirilenler": os.path.join(user_home, "Downloads"),
            "documents": os.path.join(user_home, "Documents"),
            "belgeler": os.path.join(user_home, "Documents"),
            "pictures": os.path.join(user_home, "Pictures"),
            "resimler": os.path.join(user_home, "Pictures"),
            "music": os.path.join(user_home, "Music"),
            "müzik": os.path.join(user_home, "Music"),
            "videos": os.path.join(user_home, "Videos"),
            "videolar": os.path.join(user_home, "Videos"),
            "cd": user_home,
            "c": "C:\\",
            ".": os.getcwd(),
        }
        if not arg.strip():
            hedef = os.getcwd()
            p = Path(hedef)
            if not p.exists() or not p.is_dir():
                await ctx.send(f"Geçersiz dizin: {hedef}")
                return
            items = []
            for item in sorted(p.iterdir()):
                if item.is_dir():
                    items.append(f"📁 {item.name}")
                else:
                    size = item.stat().st_size
                    size_str = f"{size/1024/1024:.1f}MB" if size > 1024*1024 else f"{size/1024:.1f}KB" if size > 1024 else f"{size}B"
                    if str(item) in encrypted_files:
                        items.append(f"🔒 {item.name} ({size_str})")
                    else:
                        items.append(f"📄 {item.name} ({size_str})")
            chunks = []
            current_chunk = f"**{p.resolve()} (botun bulunduğu dizin)**\n"
            for item in items:
                if len(current_chunk) + len(item) + 1 > 1900:
                    chunks.append(current_chunk)
                    current_chunk = f"**{p.resolve()} (devam)**\n"
                current_chunk += item + "\n"
            if current_chunk:
                chunks.append(current_chunk)
