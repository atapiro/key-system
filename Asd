async def get_all_pcs():
    active_pcs = []
    inactive_pcs = []
    for pc_id, data in pc_list.items():
        channel = bot.get_channel(data["channel"])
        if channel:
            if time.time() - data["last_seen"] < 120:
                active_pcs.append(data)
            else:
                inactive_pcs.append(data)
        else:
            inactive_pcs.append(data)
    return active_pcs, inactive_pcs

@bot.command(name="toplu")
async def toplu(ctx, *, komut: str = None):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    active_pcs, inactive_pcs = await get_all_pcs()
    if not komut:
        msg = f"**📊 TOPLU PC DURUMU**\n"
        msg += f"─────────────────────\n"
        msg += f"🟢 **Aktif PC'ler ({len(active_pcs)})**\n"
        for pc in active_pcs:
            msg += f"  ✅ `{pc['name']}` ({pc['ip']}) - {pc['user']}\n"
        msg += f"\n🔴 **Pasif PC'ler ({len(inactive_pcs)})**\n"
        for pc in inactive_pcs:
            msg += f"  ❌ `{pc['name']}` ({pc['ip']}) - {pc['user']}\n"
        msg += f"\n📊 **Toplam:** {len(active_pcs) + len(inactive_pcs)} PC"
        await ctx.send(msg)
        return
    if not active_pcs:
        await ctx.send("❌ Aktif PC bulunamadı!")
        return
    await ctx.send(f"🔄 **Toplu komut gönderiliyor: `{komut}`**\nHedef: {len(active_pcs)} PC")
    results = []
    for pc in active_pcs:
        channel = bot.get_channel(pc["channel"])
        if channel:
            try:
                await channel.send(f"```!{komut}```")
                results.append(f"✅ `{pc['name']}`: Komut gönderildi")
            except Exception as e:
                results.append(f"❌ `{pc['name']}`: Hata - {e}")
        else:
            results.append(f"❌ `{pc['name']}`: Kanal bulunamadı")
    msg = "**📤 TOPLU KOMUT SONUÇLARI**\n" + "\n".join(results)
    if len(msg) > 1900:
        chunks = [msg[i:i+1900] for i in range(0, len(msg), 1900)]
        for chunk in chunks:
            await ctx.send(chunk)
    else:
        await ctx.send(msg)

