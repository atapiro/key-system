@bot.command(name="kilit")
async def kilit(ctx, dosya: str, *, sifre: str):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    try:
        p = Path(dosya)
        if not p.exists():
            await ctx.send(f"❌ Dosya bulunamadı: `{dosya}`")
            return
        temp_zip = str(p) + ".tmp.zip"
        password = sifre.encode('utf-8')
        with pyzipper.AESZipFile(temp_zip, 'w', compression=pyzipper.ZIP_LZMA, encryption=pyzipper.WZ_AES) as zf:
            zf.setpassword(password)
            zf.write(str(p), arcname=p.name)
        os.remove(str(p))
        os.rename(temp_zip, str(p))
        encrypted_files.add(str(p))
        await ctx.send(f"🔒 Dosya şifrelendi: `{p.name}` (Şifre: `{sifre}`)")
    except Exception as e:
        await ctx.send(f"❌ Hata: {e}")

