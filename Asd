                return
            if not os.path.isdir(arg):
                await ctx.send(f"Belirtilen yol bir dizin değil: **{arg}**")
                return
            yol = arg
        p = Path(yol)
        if not p.exists() or not p.is_dir():
            await ctx.send(f"Geçersiz yol: **{yol}**")
            return
        items = []
        for item in sorted(p.iterdir()):
