@bot.command(name="çöz")
async def coz(ctx, dosya: str, *, sifre: str):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    try:
        p = Path(dosya)
        if not p.exists():
            await ctx.send(f"❌ Dosya bulunamadı: `{dosya}`")
            return
        try:
            password = sifre.encode('utf-8')
            with pyzipper.AESZipFile(str(p), 'r') as zf:
                zf.setpassword(password)
                file_list = zf.namelist()
                if not file_list:
                    await ctx.send("❌ Bu dosya şifreli bir ZIP değil veya boş.")
                    return
                original_name = file_list[0]
                temp_dir = tempfile.mkdtemp()
                zf.extractall(temp_dir)
                extracted_file = os.path.join(temp_dir, original_name)
                if os.path.exists(extracted_file):
                    os.remove(str(p))
                    shutil.move(extracted_file, str(p))
                    shutil.rmtree(temp_dir)
                    encrypted_files.discard(str(p))
                    await ctx.send(f"✅ Dosya başarıyla çözüldü: `{p.name}`")
                else:
                    await ctx.send("❌ Dosya çözülemedi, içerik bulunamadı.")
                    shutil.rmtree(temp_dir)
        except RuntimeError:
            await ctx.send("❌ **Yanlış şifre!** Dosya çözülemedi.")
        except Exception as e:
            await ctx.send(f"❌ Hata: {e}")
    except Exception as e:
        await ctx.send(f"❌ Hata: {e}")

