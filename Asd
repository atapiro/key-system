@bot.command(name="clipboard")
async def clipboard(ctx, *, arg: str = ""):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    if not check_pc_channel(ctx):
        await ctx.send("❌ Bu komut sadece kendi PC kanalında çalışır!")
        return
    if not arg.strip():
        await ctx.send("Kullanım:\n`!clipboard oku` - Panoyu okur\n`!clipboard yaz <metin>` - Panoya yazar\n`!clipboard temizle` - Panoyu temizler")
        return
    parts = arg.split(maxsplit=1)
    islem = parts[0].lower()
    try:
        import win32clipboard
        if islem == "oku":
            win32clipboard.OpenClipboard()
            data = win32clipboard.GetClipboardData()
            win32clipboard.CloseClipboard()
            if data:
                await ctx.send(f"📋 **Pano içeriği:**\n```\n{data[:1500]}\n```")
            else:
                await ctx.send("📋 Pano boş.")
        elif islem == "yaz":
            if len(parts) < 2:
                await ctx.send("❌ Metin girin: `!clipboard yaz <metin>`")
                return
            win32clipboard.OpenClipboard()
            win32clipboard.EmptyClipboard()
            win32clipboard.SetClipboardText(parts[1])
            win32clipboard.CloseClipboard()
            await ctx.send(f"✅ Panoya yazıldı: `{parts[1][:100]}{'...' if len(parts[1])>100 else ''}`")
        elif islem == "temizle":
            win32clipboard.OpenClipboard()
            win32clipboard.EmptyClipboard()
            win32clipboard.CloseClipboard()
            await ctx.send("✅ Pano temizlendi.")
        else:
            await ctx.send("❌ Geçersiz işlem. Kullanım: `!clipboard oku/yaz/temizle`")
    except Exception as e:
        await ctx.send(f"❌ Pano hatası: {e}")

