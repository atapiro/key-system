@bot.command(name="indir")
async def indir(ctx, *, hedef: str):
    if ctx.author.id != ALLOWED_USER_ID:
        return
    try:
        p = Path(hedef)
        if not p.exists():
            await ctx.send(f"❌ Yol bulunamadı: `{hedef}`")
            return
        if p.is_dir():
            await ctx.send(f"📁 Klasör algılandı, sıkıştırılıyor...")
            with tempfile.TemporaryDirectory() as tmpdir:
                zip_name = p.name
                zip_path = os.path.join(tmpdir, zip_name)
                shutil.make_archive(zip_path, 'zip', root_dir=str(p))
                zip_file = zip_path + '.zip'
                dosya_boyutu = os.path.getsize(zip_file)
                if dosya_boyutu <= 7.9 * 1024 * 1024:
                    await ctx.send(f"📦 Sıkıştırıldı: `{zip_name}.zip` ({dosya_boyutu/1024/1024:.2f} MB)")
                    await ctx.send(file=discord.File(zip_file))
                else:
                    await ctx.send(f"⚠️ ZIP çok büyük ({dosya_boyutu/1024/1024:.2f} MB), parçalara bölünüyor...")
                    chunk_size = 7 * 1024 * 1024
                    with open(zip_file, 'rb') as f:
                        chunk_num = 1
                        while True:
                            chunk_data = f.read(chunk_size)
                            if not chunk_data:
                                break
                            chunk_name = f"{zip_name}.part{chunk_num:03d}.zip"
                            with tempfile.NamedTemporaryFile(suffix=".zip", delete=False) as tmp_chunk:
                                tmp_chunk.write(chunk_data)
                                tmp_chunk_path = tmp_chunk.name
                            await ctx.send(f"📎 Parça {chunk_num}: `{chunk_name}` ({len(chunk_data)/1024/1024:.2f} MB)",
                                           file=discord.File(tmp_chunk_path, filename=chunk_name))
                            os.unlink(tmp_chunk_path)
                            chunk_num += 1
                    await ctx.send(
                        f"✅ {chunk_num-1} parça gönderildi.\n"
                        f"**Birleştirme:** Tüm parçaları aynı klasöre indir, CMD'de:\n"
                        f"`copy /b {zip_name}.part*.zip {zip_name}.zip`\n"
                        f"ve sonra ZIP'i normal aç."
                    )
            return
        size_mb = p.stat().st_size / (1024 * 1024)
        if size_mb <= 8:
            file = discord.File(p, filename=p.name)
            await ctx.send(f"📁 Dosya gönderiliyor: **{p.name}** ({size_mb:.1f} MB)", file=file)
            return
        await ctx.send(f"⚠️ Dosya çok büyük ({size_mb:.2f} MB), 7 MB'lık parçalara bölünüyor...")
        chunk_size = 7 * 1024 * 1024
        base_name = p.stem
        ext = p.suffix
        chunk_num = 1
        with open(p, 'rb') as f:
            while True:
                chunk_data = f.read(chunk_size)
                if not chunk_data:
                    break
                chunk_name = f"{base_name}.part{chunk_num:03d}{ext}"
                with tempfile.NamedTemporaryFile(suffix=ext, delete=False) as tmp:
                    tmp.write(chunk_data)
                    tmp_path = tmp.name
                await ctx.send(
                    f"📎 Parça {chunk_num}: `{chunk_name}` ({len(chunk_data)/1024/1024:.2f} MB)",
                    file=discord.File(tmp_path, filename=chunk_name)
                )
                os.unlink(tmp_path)
                chunk_num += 1
        await ctx.send(
            f"✅ Toplam {chunk_num-1} parça gönderildi.\n"
            f"**Birleştirme:** Tüm parçaları aynı klasöre indir, CMD'de:\n"
            f"`copy /b {base_name}.part*{ext} {p.name}`\n"
            f"Ardından dosyayı normal kullan."
        )
    except Exception as e:
        await ctx.send(f"❌ Hata: `{str(e)}`")

